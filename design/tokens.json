{
  "$description": "Zewar design tokens (W3C Design Tokens). Load into Figma with Tokens Studio; `npm run tokens` regenerates the CSS variables.",
  "primitive": {
    "ink": {
      "950": {
        "$type": "color",
        "$value": "#0e0b0a"
      },
      "900": {
        "$type": "color",
        "$value": "#15110f"
      },
      "850": {
        "$type": "color",
        "$value": "#1c1714"
      },
      "800": {
        "$type": "color",
        "$value": "#251e1a"
      },
      "700": {
        "$type": "color",
        "$value": "#3a3029"
      },
      "600": {
        "$type": "color",
        "$value": "#544638"
      }
    },
    "ivory": {
      "100": {
        "$type": "color",
        "$value": "#f6efe4"
      },
      "300": {
        "$type": "color",
        "$value": "#cdbfab"
      },
      "500": {
        "$type": "color",
        "$value": "#a39582"
      }
    },
    "gold": {
      "300": {
        "$type": "color",
        "$value": "#f0d49a"
      },
      "400": {
        "$type": "color",
        "$value": "#e2bf78"
      },
      "500": {
        "$type": "color",
        "$value": "#d3a95c"
      },
      "900": {
        "$type": "color",
        "$value": "#1c140a"
      }
    },
    "jade": {
      "400": {
        "$type": "color",
        "$value": "#86cfa8"
      }
    },
    "coral": {
      "400": {
        "$type": "color",
        "$value": "#ec8576"
      }
    },
    "amber": {
      "400": {
        "$type": "color",
        "$value": "#e9bb5e"
      }
    }
  },
  "color": {
    "bg": {
      "$type": "color",
      "$value": "{primitive.ink.950}"
    },
    "surface": {
      "$type": "color",
      "$value": "{primitive.ink.900}"
    },
    "surface-2": {
      "$type": "color",
      "$value": "{primitive.ink.850}"
    },
    "media": {
      "$type": "color",
      "$value": "{primitive.ink.850}"
    },
    "border": {
      "$type": "color",
      "$value": "{primitive.ink.800}"
    },
    "border-strong": {
      "$type": "color",
      "$value": "{primitive.ink.700}"
    },
    "text": {
      "$type": "color",
      "$value": "{primitive.ivory.100}"
    },
    "text-muted": {
      "$type": "color",
      "$value": "{primitive.ivory.500}"
    },
    "accent": {
      "$type": "color",
      "$value": "{primitive.gold.400}"
    },
    "accent-hover": {
      "$type": "color",
      "$value": "{primitive.gold.300}"
    },
    "accent-contrast": {
      "$type": "color",
      "$value": "{primitive.gold.900}"
    },
    "success": {
      "$type": "color",
      "$value": "{primitive.jade.400}"
    },
    "warning": {
      "$type": "color",
      "$value": "{primitive.amber.400}"
    },
    "danger": {
      "$type": "color",
      "$value": "{primitive.coral.400}"
    },
    "focus": {
      "$type": "color",
      "$value": "{primitive.gold.300}"
    },
    "overlay": {
      "$type": "color",
      "$value": "rgba(5, 4, 3, 0.7)"
    },
    "star": {
      "$type": "color",
      "$value": "{primitive.gold.400}"
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": "Cardo, 'Cormorant Garamond', Georgia, serif"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "'DM Sans', Inter, system-ui, sans-serif"
      }
    },
    "weight": {
      "display": {
        "$type": "fontWeight",
        "$value": 400
      }
    },
    "tracking": {
      "display": {
        "$type": "string",
        "$value": "-0.01em"
      },
      "button": {
        "$type": "string",
        "$value": "0.14em"
      },
      "nav": {
        "$type": "string",
        "$value": "0.16em"
      }
    },
    "case": {
      "button": {
        "$type": "string",
        "$value": "uppercase"
      },
      "nav": {
        "$type": "string",
        "$value": "uppercase"
      }
    },
    "size": {
      "card": {
        "$type": "dimension",
        "$value": "21px"
      }
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": "2px"
    },
    "input": {
      "$type": "dimension",
      "$value": "2px"
    },
    "card": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "shadow": {
    "lg": {
      "$type": "shadow",
      "$value": "0 30px 80px rgba(0, 0, 0, 0.55)"
    }
  }
}